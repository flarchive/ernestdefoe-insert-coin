{
    "name": "ernestdefoe/insert-coin",
    "description": "Insert Coin — an arcade for Flarum. HTML5 games in a sandboxed cabinet, signed play sessions, leaderboards for all time, this month and this week, champions with crowns, dethroned alerts, a Hall of Fame and seven original starter games.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "arcade",
        "games",
        "html5",
        "leaderboard",
        "high-scores",
        "ibarcade"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/insert-coin",
    "support": {
        "issues": "https://github.com/ernestdefoe/insert-coin/issues",
        "source": "https://github.com/ernestdefoe/insert-coin"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\InsertCoin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\InsertCoin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Insert Coin",
            "category": "feature",
            "icon": {
                "name": "fas fa-gamepad",
                "backgroundColor": "#1e1b4b",
                "color": "#facc15"
            },
            "optional-dependencies": [
                "fof/gamification",
                "flarum/realtime",
                "fof/forum-widgets-core"
            ]
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
