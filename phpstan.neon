includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first
    # time it runs, and parallel workers each start that install at once.
    parallel:
        maximumNumberOfProcesses: 1
    level: 6
    paths:
        - extend.php
        - src
    # flarum/realtime is optional and not a dependency: the extender Insert
    # Coin uses is described for the analyser only.
    scanFiles:
        - tests/phpstan/optional-extensions.php
    databaseMigrationsPath:
        - migrations
